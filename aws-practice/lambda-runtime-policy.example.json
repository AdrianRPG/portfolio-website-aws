{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWeatherApiKey",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:us-east-2:YOUR_AWS_ACCOUNT_ID:parameter/portfolio/weather/openweather-api-key"
    },
    {
      "Sid": "WriteWeatherDataToS3",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/data/weather.json"
    }
  ]
}